# Local dev server (Next.js default port)
NEXT_PUBLIC_APP_URL=http://localhost:4020

# Convex — copy URL from `npx convex dev` output
NEXT_PUBLIC_CONVEX_URL=

# Clerk — from clerk.com dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Comma-separated Clerk user IDs for app builders (org switcher access)
SUPERUSER_CLERK_IDS=
NEXT_PUBLIC_SUPERUSER_CLERK_IDS=

# Google Calendar OAuth (optional, v1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ char random string for encrypting refresh tokens at rest
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Clerk JWT issuer for Convex auth (from Clerk → Convex integration setup)
CLERK_JWT_ISSUER_DOMAIN=
